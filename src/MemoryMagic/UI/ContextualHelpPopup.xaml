<UserControl x:Class="MemoryMagic.UI.ContextualHelpPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#1E293B"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            MaxWidth="360">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Action Name -->
            <DockPanel Margin="0,0,0,6">
                <Border Background="#0EA5E9" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="11" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Foreground="#F8FAFC"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Plain-Language Summary -->
            <TextBlock x:Name="SummaryText"
                       Foreground="#CBD5E1"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="0,0,0,8" />

            <!-- Reversible / Irreversible Side Effects -->
            <Border x:Name="ImpactBadge"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,5"
                    Margin="0,0,0,8">
                <TextBlock x:Name="ImpactText"
                           Foreground="#94A3B8"
                           FontSize="11.5"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Shortcut / Escape Hint -->
            <TextBlock Text="Tip: Hold Shift + Right-Click for standard menu  •  Esc to close"
                       Foreground="#64748B"
                       FontSize="10.5"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
