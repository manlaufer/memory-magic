<Window x:Class="MemoryMagic.UI.ExecutionProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operation Progress"
        Width="660"
        Height="440"
        MinWidth="540"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#11151C"
        Foreground="#F8FAFC"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText"
                       Text="Executing Operation..."
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#38BDF8" />
            <TextBlock x:Name="SubtitleText"
                       Text="Preparing task..."
                       FontSize="12.5"
                       Foreground="#94A3B8"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Step & Progress Bar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,5">
                <TextBlock x:Name="StepText"
                           Text="Starting..."
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="#E2E8F0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PercentText"
                           DockPanel.Dock="Right"
                           Text=""
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#38BDF8"
                           Margin="10,0,0,0" />
            </DockPanel>
            <ProgressBar x:Name="OperationProgressBar"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="True"
                         Background="#1E293B"
                         Foreground="#2563EB"
                         BorderBrush="#334155"
                         BorderThickness="1" />
        </StackPanel>

        <!-- Live Console Output -->
        <Border Grid.Row="2"
                Background="#0B1120"
                BorderBrush="#2D3748"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6">
            <TextBox x:Name="LogTextBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="Transparent"
                     Foreground="#CBD5E1"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="12" />
        </Border>

        <!-- Final Outcome Banner (Success / Failure) -->
        <Border x:Name="ResultBanner"
                Grid.Row="3"
                Visibility="Collapsed"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,9"
                Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="ResultHeadlineText"
                           FontSize="13.5"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ResultDetailsText"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Background="#334155"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Background="#2563EB"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
