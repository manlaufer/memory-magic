<Window x:Class="MemoryMagic.UI.TelemetryBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="568"
        MinWidth="568"
        MaxWidth="568"
        Height="36"
        MinHeight="36"
        MaxHeight="36"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnMouseDownDrag">

    <Window.ContextMenu>
        <ContextMenu x:Name="BarContextMenu" Opened="OnBarContextMenuOpened">
            <MenuItem x:Name="DiskDriveMenu" Header="Disk Drive Scope" />
            <Separator />
            <MenuItem x:Name="PinToTaskbarMenuItem"
                      Header="Pin to Taskbar"
                      IsCheckable="True"
                      Click="OnPinToTaskbarClick" />
            <MenuItem x:Name="FloatingMenuItem"
                      Header="Floating (Draggable)"
                      IsCheckable="True"
                      Click="OnFloatingModeClick" />
            <MenuItem x:Name="AlwaysOnTopMenuItem"
                      Header="Always on Top"
                      IsCheckable="True"
                      Click="OnAlwaysOnTopClick" />
            <MenuItem x:Name="LockPositionMenuItem"
                      Header="Lock Position"
                      IsCheckable="True"
                      Click="OnLockPositionMenuClick" />
            <Separator />
            <MenuItem Header="Refresh Rate">
                <MenuItem x:Name="Rate1sMenuItem" Header="1s" IsCheckable="True" Tag="1" Click="OnRefreshRateClick" />
                <MenuItem x:Name="Rate2sMenuItem" Header="2s" IsCheckable="True" Tag="2" Click="OnRefreshRateClick" />
                <MenuItem x:Name="Rate5sMenuItem" Header="5s" IsCheckable="True" Tag="5" Click="OnRefreshRateClick" />
                <MenuItem x:Name="Rate10sMenuItem" Header="10s" IsCheckable="True" Tag="10" Click="OnRefreshRateClick" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Open Dashboard" Click="OnOpenDashboardClick" />
            <MenuItem Header="Hide Telemetry Bar" Click="OnHideBarClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#F00F172A"
            BorderBrush="#38BDF8"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,4">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="202" />
                <ColumnDefinition x:Name="BatteryColumn" Width="0" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <!-- CPU -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="CPU Usage">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="#38BDF8" Margin="0,0,5,0"
                      Data="M6,2V4H4A2,2 0 0,0 2,6V8H0V10H2V14H0V16H2V18A2,2 0 0,0 4,20H6V22H8V20H12V22H14V20H16A2,2 0 0,0 18,18V16H20V14H18V10H20V8H18V6A2,2 0 0,0 16,4H14V2H12V4H8V2H6M4,6H16V18H4V6M7,9V15H13V9H7Z" />
                <TextBlock x:Name="CpuText" Width="64" Text="CPU  --%" Foreground="#F8FAFC"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                           TextWrapping="NoWrap" VerticalAlignment="Center" />
            </StackPanel>

            <!-- RAM -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Physical RAM Usage">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="#60A5FA" Margin="0,0,5,0"
                      Data="M2,7H22V17H2V7M4,9V15H6V9H4M8,9V15H10V9H8M12,9V15H14V9H12M16,9V15H20V9H16M4,18H8V20H4V18M10,18H14V20H10V18M16,18H20V20H16V18Z" />
                <TextBlock x:Name="RamText" Width="64" Text="RAM  --%" Foreground="#F8FAFC"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                           TextWrapping="NoWrap" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Network Up / Down -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Network Download / Upload Speed">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="#34D399" Margin="0,0,5,0"
                      Data="M16,17H19V11H22L17.5,6.5L13,11H16V17M6.5,17.5L11,13H8V7H5V13H2L6.5,17.5Z" />
                <TextBlock x:Name="NetText" Width="126" Text="↓   0B ↑   0B" Foreground="#E2E8F0"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                           TextWrapping="NoWrap" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Disk Active %, Free Space, WMI Health & Drive Selector -->
            <StackPanel x:Name="DiskWidgetPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Disk Active %, Free Space &amp; Health">
                <Path Width="12" Height="12" Stretch="Uniform" Fill="#FBBF24" Margin="0,0,5,0"
                      Data="M6,2H18A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12,4A6,6 0 0,0 6,10A6,6 0 0,0 12,16A6,6 0 0,0 18,10A6,6 0 0,0 12,4M12,9A1,1 0 0,1 13,10A1,1 0 0,1 12,11A1,1 0 0,1 11,10A1,1 0 0,1 12,9M7,18V20H17V18H7Z" />
                <TextBlock x:Name="DiskText" Width="106" Text="ALL   0%   --G" Foreground="#E2E8F0"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                <TextBlock x:Name="DiskHealthText" Width="36" Text="OK" Foreground="#4ADE80"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           TextWrapping="NoWrap" Margin="4,0,2,0" VerticalAlignment="Center" />
                <Button x:Name="DiskSelectorButton"
                        Content="▾"
                        Width="20"
                        Height="20"
                        Padding="0"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        Foreground="#94A3B8"
                        FontSize="10"
                        ToolTip="Select All Drives or a Specific Drive"
                        Click="OnDiskSelectorButtonClick">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="DiskSelectorContextMenu" />
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <!-- Battery (auto-collapsed on desktop PCs with no physical battery) -->
            <StackPanel x:Name="BatteryPanel" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Battery Charge">
                <Path Width="13" Height="13" Stretch="Uniform" Fill="#4ADE80" Margin="0,0,4,0"
                      Data="M16,20H8V6H16M16.67,4H15V2H9V4H7.33A1.33,1.33 0 0,0 6,5.33V20.67C6,21.4 6.6,22 7.33,22H16.67A1.33,1.33 0 0,0 18,20.67V5.33C18,4.6 17.4,4 16.67,4Z" />
                <TextBlock x:Name="BatteryText" Width="56" Text=" --%" Foreground="#F8FAFC"
                           FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold"
                           TextWrapping="NoWrap" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Pin / Lock Position Toggle -->
            <ToggleButton x:Name="LockPositionButton"
                          Grid.Column="5"
                          Width="20"
                          Height="20"
                          Margin="4,0,0,0"
                          Padding="0"
                          Background="#1E293B"
                          BorderBrush="#334155"
                          BorderThickness="1"
                          Cursor="Hand"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          ToolTip="Position Unlocked — Drag to Move (Click to Lock)"
                          Click="OnLockPositionButtonClick">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </ToggleButton.Template>
                <Path x:Name="LockIconPath"
                      Width="11"
                      Height="11"
                      Stretch="Uniform"
                      Fill="#94A3B8"
                      Data="M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H15V6A3,3 0 0,0 12,3A3,3 0 0,0 9,6H7A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17Z" />
            </ToggleButton>
        </Grid>
    </Border>
</Window>
