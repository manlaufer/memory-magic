<Window x:Class="MemoryMagic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MemoryMagic.UI"
        ui:ContextualHelp.EnableGlobalHelp="True"
        Title="{Binding WindowTitle}"
        Width="1040" Height="700"
        MinWidth="860" MinHeight="580"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Privilege Banner -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Memory Magic" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PrivilegeStatusText}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="On Close:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                    <ComboBox Width="175"
                              ItemsSource="{Binding CloseBehaviorOptions}"
                              SelectedItem="{Binding SelectedCloseBehavior}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              ui:ContextualHelp.Title="Window Close Behavior"
                              ui:ContextualHelp.Summary="Choose whether clicking Close (X) asks each time, minimizes to the System Tray in the background, or exits completely."
                              ui:ContextualHelp.Impact="Reversible — saved in your user profile and changeable anytime." />
                    <Button Content="User Guide" Command="{Binding OpenUserGuideCommand}"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="#1E3A8A" Foreground="White" BorderThickness="0"
                            ui:ContextualHelp.Title="Open User Guide"
                            ui:ContextualHelp.Summary="Opens the beginner-friendly Memory Magic User Guide in your default web browser."
                            ui:ContextualHelp.Impact="Reversible — opens UserGuide.html locally." />
                    <Button Content="Minimize to Tray" Command="{Binding MinimizeToTrayCommand}"
                            Padding="12,6" Margin="0,0,8,0"
                            Background="#334155" Foreground="White" BorderThickness="0"
                            ui:ContextualHelp.Title="Minimize to System Tray"
                            ui:ContextualHelp.Summary="Hides the main window into the Windows Notification Area (System Tray) while keeping live RAM monitoring active."
                            ui:ContextualHelp.Impact="Reversible — double-click the tray icon or right-click and choose Open to restore." />
                    <Button Content="Elevate (UAC)" Command="{Binding ElevateCommand}"
                            Padding="14,6" VerticalAlignment="Center"
                            Background="#D97706" Foreground="White" BorderThickness="0"
                            ui:ContextualHelp.Title="Restart as Administrator"
                            ui:ContextualHelp.Summary="Restarts Memory Magic with Windows Administrator permissions so it can clear deep system memory caches, toggle all-user startup apps, and manage Windows Optional Features."
                            ui:ContextualHelp.Impact="Restarts the app with a Windows UAC prompt; no files or settings are changed automatically." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    SelectionChanged="OnMainTabSelectionChanged">

            <!-- TAB 1: MEMORY OPTIMIZER -->
            <TabItem Header="Memory Optimizer"
                     ui:ContextualHelp.Title="Memory Optimizer Tab"
                     ui:ContextualHelp.Summary="Shows live RAM usage and lets you free unused memory manually or turn on automatic background optimization."
                     ui:ContextualHelp.Impact="Reversible — only switches the active view.">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding PhysicalRamSummary}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RamLoadPercent, StringFormat={}{0:F0}%}"
                                               HorizontalAlignment="Right" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" />
                                </Grid>
                                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding RamLoadPercent, Mode=OneWay}"
                                             Foreground="#2563EB" Background="#0F172A" BorderThickness="0" />
                                <TextBlock Text="{Binding KernelDetailsSummary}" Foreground="{StaticResource TextMuted}"
                                           FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Manual Controls -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Manual Optimization" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button Content="One-Click Safe Optimize (Working Sets + Low-Prio Standby)"
                                            Command="{Binding OptimizeSafeCommand}"
                                            Padding="16,10" Margin="0,0,10,6"
                                            Background="{StaticResource BgAccent}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            ui:ContextualHelp.Title="Safe Memory Optimize"
                                            ui:ContextualHelp.Summary="Gently asks background apps to release idle memory they are not actively using and clears low-priority cached memory, without touching your active window or closing any app."
                                            ui:ContextualHelp.Impact="Reversible &amp; Safe — apps automatically reload any memory pages they need later." />
                                    <Button Content="Deep Purge (Modified + Standby + File Cache)"
                                            Command="{Binding OptimizeDeepCommand}"
                                            Padding="16,10" Margin="0,0,0,6"
                                            Background="#0F766E" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            ui:ContextualHelp.Title="Deep Memory Purge"
                                            ui:ContextualHelp.Summary="Flushes pending modified memory to disk, trims app working sets, and clears the full Windows Standby and File Cache lists to maximize immediately free RAM."
                                            ui:ContextualHelp.Impact="Reversible (Requires Admin for full purge) — apps remain open, though recently cached files may briefly reload from disk." />
                                </WrapPanel>
                                <TextBlock Text="{Binding LastOptimizationSummary}" Foreground="#38BDF8" FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Automatic Background Daemon -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <CheckBox Content="Enable Automatic Background Threshold Monitor"
                                          IsChecked="{Binding AutoOptimizeEnabled}"
                                          Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"
                                          ui:ContextualHelp.Title="Automatic Memory Monitor"
                                          ui:ContextualHelp.Summary="Turns on a quiet background watcher that automatically frees memory whenever your RAM usage crosses your chosen limit or after your set timer."
                                          ui:ContextualHelp.Impact="Reversible — runs safely with a cooldown timer and can be turned off anytime." />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM Pressure Trigger (%)" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <Slider Grid.Column="1" Minimum="50" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding AutoThresholdPercent}" VerticalAlignment="Center"
                                            ui:ContextualHelp.Title="RAM Pressure Trigger (%)"
                                            ui:ContextualHelp.Summary="Sets how full your RAM must get before automatic optimization runs (for example, 85% means it triggers when 85% of physical memory is in use)."
                                            ui:ContextualHelp.Impact="Reversible — adjust anytime without restarting." />
                                    <TextBlock Grid.Column="2" Text="{Binding AutoThresholdPercent, StringFormat={}{0:F0}%}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Periodic Interval (minutes, 0=off)" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                    <TextBox Grid.Column="1" Text="{Binding AutoIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderBrushDark}" Padding="6,4"
                                             ui:ContextualHelp.Title="Periodic Schedule (Minutes)"
                                             ui:ContextualHelp.Summary="Sets how often automatic memory optimization runs on a timer even if RAM is below the threshold. Enter 0 to trigger only on high RAM usage."
                                             ui:ContextualHelp.Impact="Reversible — takes effect immediately for future checks." />
                                </Grid>

                                <CheckBox Content="Use Deep Purge for automatic runs (requires Administrator)"
                                          IsChecked="{Binding DeepPurgeAuto}"
                                          Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"
                                          ui:ContextualHelp.Title="Automatic Deep Purge"
                                          ui:ContextualHelp.Summary="When checked, automatic background cleanups also flush the Windows Standby and File Cache lists instead of doing only a light working-set trim."
                                          ui:ContextualHelp.Impact="Reversible (Requires Admin) — clears disk cache periodically; uncheck for gentler background cleanup." />
                            </StackPanel>
                        </Border>

                        <!-- Floating Performance Bar Controls -->
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Floating Performance Bar" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <CheckBox Content="Enable Floating Performance Bar (CPU / RAM / Disk / Net)"
                                          IsChecked="{Binding PerformanceBarVisible}"
                                          Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"
                                          ui:ContextualHelp.Title="Floating Performance Bar Visibility"
                                          ui:ContextualHelp.Summary="Shows or hides the compact floating telemetry bar on your desktop (also accessible from the System Tray menu)."
                                          ui:ContextualHelp.Impact="Reversible — state is saved in your user profile." />
                                <CheckBox Content="Always on Top (Keep Performance Bar above other windows)"
                                          IsChecked="{Binding PerformanceBarAlwaysOnTop}"
                                          Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"
                                          ui:ContextualHelp.Title="Performance Bar Always on Top"
                                          ui:ContextualHelp.Summary="Keeps the floating Performance Bar pinned above all other open windows when enabled."
                                          ui:ContextualHelp.Impact="Reversible — toggles the Topmost window flag immediately." />
                                <CheckBox Content="Lock Performance Bar Position (Freeze screen coordinates)"
                                          IsChecked="{Binding PerformanceBarPositionLocked}"
                                          Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"
                                          ui:ContextualHelp.Title="Lock Performance Bar Position"
                                          ui:ContextualHelp.Summary="Freezes the Performance Bar at its current screen coordinates so it cannot be dragged accidentally. Uncheck to drag freely."
                                          ui:ContextualHelp.Impact="Reversible — saved in your user profile." />
                                <CheckBox Content="Run at Windows Startup (Launch minimized to System Tray)"
                                          IsChecked="{Binding RunAtWindowsStartup}"
                                          Foreground="{StaticResource TextPrimary}"
                                          ui:ContextualHelp.Title="Run at Windows Startup"
                                          ui:ContextualHelp.Summary="Automatically launches Memory Magic in the System Tray when you sign in to Windows via HKCU Run."
                                          ui:ContextualHelp.Impact="Reversible — adds or removes HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run\\MemoryMagic." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PROCESS PROFILER -->
            <TabItem Header="Process Profiler"
                     ui:ContextualHelp.Title="Process Profiler Tab"
                     ui:ContextualHelp.Summary="Lists every running program and shows how much private, shared, and system pool memory each one uses."
                     ui:ContextualHelp.Impact="Reversible — read-only monitoring unless you click Trim.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <TextBox Width="260" Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderBrushDark}"
                                 Padding="8,5" ToolTip="Filter by process name or PID"
                                 ui:ContextualHelp.Title="Process Search Filter"
                                 ui:ContextualHelp.Summary="Type part of a program name or process ID (PID) to quickly filter the running processes list."
                                 ui:ContextualHelp.Impact="Reversible — only filters what is shown in the table." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}"
                                    Padding="12,5" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0"
                                    ui:ContextualHelp.Title="Refresh Process List"
                                    ui:ContextualHelp.Summary="Takes a fresh real-time snapshot of all running programs and their current memory numbers."
                                    ui:ContextualHelp.Impact="Reversible — read-only refresh." />
                            <Button Content="Trim Selected Working Set" Command="{Binding TrimSelectedProcessCommand}"
                                    Padding="12,5" Background="{StaticResource BgAccent}" Foreground="White" BorderThickness="0"
                                    ui:ContextualHelp.Title="Trim Selected Program"
                                    ui:ContextualHelp.Summary="Asks the selected program to release unused memory back to Windows without closing it. Critical Windows processes are protected and automatically blocked."
                                    ui:ContextualHelp.Impact="Reversible — does not terminate the app; Windows restores pages if the app needs them." />
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              RowBackground="#1A202C" AlternatingRowBackground="#151B26"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3748"
                              HeadersVisibility="Column"
                              ui:ContextualHelp.Title="Running Processes Table"
                              ui:ContextualHelp.Summary="Shows each running app sorted by Private RAM usage. Rows highlighted in dark red use a high amount of memory; select a row and click Trim Selected to reduce its footprint."
                              ui:ContextualHelp.Impact="Reversible — selecting or sorting rows makes no system changes.">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHighConsumption}" Value="True">
                                        <Setter Property="Background" Value="#3F1D2B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="190" />
                            <DataGridTextColumn Header="Private WS" Binding="{Binding PrivateWsMb}" Width="95" />
                            <DataGridTextColumn Header="Shared WS" Binding="{Binding SharedWsMb}" Width="90" />
                            <DataGridTextColumn Header="Total WS" Binding="{Binding TotalWsMb}" Width="90" />
                            <DataGridTextColumn Header="Commit" Binding="{Binding CommitMb}" Width="90" />
                            <DataGridTextColumn Header="Paged Pool" Binding="{Binding PagedPoolKb}" Width="90" />
                            <DataGridTextColumn Header="Non-Paged" Binding="{Binding NonPagedPoolKb}" Width="90" />
                            <DataGridTextColumn Header="Threads" Binding="{Binding ThreadCount}" Width="65" />
                            <DataGridTextColumn Header="Status" Binding="{Binding SafetyTag}" Width="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: STARTUP MANAGER -->
            <TabItem Header="Startup Manager"
                     ui:ContextualHelp.Title="Startup Manager Tab"
                     ui:ContextualHelp.Summary="Finds apps and scheduled tasks that launch automatically when Windows starts, rates their startup impact, and lets you turn them on or off."
                     ui:ContextualHelp.Impact="Reversible — auditing is read-only until you toggle an item.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh Startup Audit" Command="{Binding RefreshStartupCommand}"
                                Padding="12,5" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0"
                                ui:ContextualHelp.Title="Refresh Startup Audit"
                                ui:ContextualHelp.Summary="Re-scans Windows Registry Run keys, Startup folders, and Scheduled Tasks for auto-start programs."
                                ui:ContextualHelp.Impact="Reversible — read-only scan." />
                        <Button Content="Enable / Disable Selected" Command="{Binding ToggleStartupCommand}"
                                Padding="12,5" Background="{StaticResource BgAccent}" Foreground="White" BorderThickness="0"
                                ui:ContextualHelp.Title="Toggle Startup Program"
                                ui:ContextualHelp.Summary="Turns the selected program's automatic launch at Windows sign-in on or off without uninstalling or deleting the program."
                                ui:ContextualHelp.Impact="Reversible (Changes Windows Startup settings; some system-wide items require Admin) — you can re-enable it anytime." />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding StartupEntries}" SelectedItem="{Binding SelectedStartupEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              RowBackground="#1A202C" AlternatingRowBackground="#151B26"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3748"
                              HeadersVisibility="Column"
                              ui:ContextualHelp.Title="Startup Programs List"
                              ui:ContextualHelp.Summary="Displays each program that starts with Windows, whether it is currently enabled, and its estimated impact on boot time and memory. Select a row to toggle it."
                              ui:ContextualHelp.Impact="Reversible — viewing the list makes no changes.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, Mode=OneWay}" Width="65" />
                            <DataGridTextColumn Header="Impact" Binding="{Binding Impact}" Width="80" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="145" />
                            <DataGridTextColumn Header="Impact Reason" Binding="{Binding ImpactReason}" Width="210" />
                            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: TEMP FILE CLEANER -->
            <TabItem Header="Temp Cleaner"
                     ui:ContextualHelp.Title="Temp Cleaner Tab"
                     ui:ContextualHelp.Summary="Scans temporary folders, browser caches, and optional system caches so you can reclaim disk space safely."
                     ui:ContextualHelp.Impact="Reversible while scanning; permanent once you click Purge Selected.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Scan Locations" Command="{Binding ScanTempCommand}"
                                Padding="12,5" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0"
                                ui:ContextualHelp.Title="Scan Temporary Files"
                                ui:ContextualHelp.Summary="Calculates how much disk space is used in your temporary folders and browser caches without deleting anything yet."
                                ui:ContextualHelp.Impact="Reversible — read-only disk scan." />
                        <Button Content="Purge Selected" Command="{Binding CleanTempCommand}"
                                Padding="12,5" Background="#DC2626" Foreground="White" BorderThickness="0"
                                ui:ContextualHelp.Title="Delete Selected Temp Files"
                                ui:ContextualHelp.Summary="Deletes the temporary files and caches in the checked categories below. Files currently in use by open apps are automatically skipped."
                                ui:ContextualHelp.Impact="Permanent / Irreversible — deleted files cannot be recovered from the Recycle Bin, though apps rebuild their own caches as needed." />
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding TempTargets}"
                              Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                              BorderBrush="{StaticResource BorderBrushDark}"
                              ui:ContextualHelp.Title="Temporary Cleanup Categories"
                              ui:ContextualHelp.Summary="Check or uncheck which temporary folders and caches to include before clicking Purge Selected."
                              ui:ContextualHelp.Impact="Reversible — checking boxes only chooses what will be cleaned.">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Foreground="{StaticResource TextPrimary}" Margin="4,6"
                                          ui:ContextualHelp.Title="{Binding DisplayName}"
                                          ui:ContextualHelp.Summary="Include or exclude this folder category when running Purge Selected. Currently open or locked files are safely skipped."
                                          ui:ContextualHelp.Impact="Permanent when purged — files in this category are deleted directly (not sent to Recycle Bin).">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EstimatedSizeDisplay}" Foreground="#38BDF8" FontSize="12" />
                                        <TextBlock Text="{Binding PathDescription}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- TAB 5: DEBLOATER -->
            <TabItem Header="Debloater"
                     ui:ContextualHelp.Title="Windows Debloater Tab"
                     ui:ContextualHelp.Summary="Scans pre-installed Store/UWP apps, Windows DISM Capabilities &amp; Features, and Schneegans-style telemetry/cleanup tweaks while protecting core OS components."
                     ui:ContextualHelp.Impact="Reversible while browsing; prompts for a System Restore Point before applying changes.">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <ComboBox Width="205"
                                  ItemsSource="{Binding DebloatCategories}"
                                  SelectedItem="{Binding SelectedDebloatCategory}"
                                  Margin="0,0,8,0"
                                  ui:ContextualHelp.Title="Debloat Category Filter"
                                  ui:ContextualHelp.Summary="Switch between UWP/Appx Apps, Windows Capabilities &amp; Optional Features, and System/Telemetry Registry Tweaks."
                                  ui:ContextualHelp.Impact="Reversible — only filters what is displayed." />

                        <TextBox Width="200" Text="{Binding DebloatFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderBrushDark}"
                                 Padding="8,5" ToolTip="Filter by app, feature, or tweak name"
                                 ui:ContextualHelp.Title="Search Apps, Features &amp; Tweaks"
                                 ui:ContextualHelp.Summary="Type part of a name or publisher to quickly filter the debloater list."
                                 ui:ContextualHelp.Impact="Reversible — only filters what is shown." />

                        <CheckBox Content="Show Protected Core"
                                  IsChecked="{Binding ShowProtectedDebloatItems}"
                                  VerticalAlignment="Center" Margin="10,0,0,0"
                                  ui:ContextualHelp.Title="Show Protected Core Components"
                                  ui:ContextualHelp.Summary="Displays critical Windows packages (Microsoft Store, ShellExperienceHost, Edge WebView2, Settings) as locked items so you can inspect them."
                                  ui:ContextualHelp.Impact="Reversible — core items remain blocked from removal." />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="Scan" Command="{Binding ScanDebloatCommand}"
                                    Padding="12,5" Margin="0,0,6,0" Background="#334155"
                                    ui:ContextualHelp.Title="Scan Windows Components"
                                    ui:ContextualHelp.Summary="Refreshes installed UWP apps, DISM capabilities/features (when elevated), and registry/power tweak status."
                                    ui:ContextualHelp.Impact="Reversible — read-only scan." />
                            <Button Content="Apply" Command="{Binding ApplyDebloatBatchCommand}"
                                    Padding="12,5" Background="#DC2626"
                                    ui:ContextualHelp.Title="Apply Selected Optimizations"
                                    ui:ContextualHelp.Summary="Prompts to create a System Restore Point and then uninstalls checked bloatware apps/capabilities or applies checked performance &amp; privacy registry tweaks."
                                    ui:ContextualHelp.Impact="Permanent / System Change — creates an optional Restore Point first; core OS packages stay blocked." />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Select All Safe Bloat" Command="{Binding SelectSafeBloatCommand}"
                                Padding="10,4" Margin="0,0,8,0" Background="#0F766E"
                                ui:ContextualHelp.Title="Select Safe Bloatware &amp; Tweaks"
                                ui:ContextualHelp.Summary="Automatically checks items classified as SafeToRemove (such as Bing, Clipchamp, Copilot, Widgets, and Telemetry minimization) that are not yet applied."
                                ui:ContextualHelp.Impact="Reversible — only selects checkboxes; nothing runs until you click Apply Selected Optimizations." />
                        <Button Content="Clear Selection" Command="{Binding ClearDebloatSelectionCommand}"
                                Padding="10,4" Margin="0,0,8,0" Background="#334155"
                                ui:ContextualHelp.Title="Clear Selection"
                                ui:ContextualHelp.Summary="Unchecks all selected items in the debloater list."
                                ui:ContextualHelp.Impact="Reversible — changes no Windows settings." />
                        <Button Content="Create Restore Point" Command="{Binding CreateRestorePointCommand}"
                                Padding="10,4" Background="#1D4ED8"
                                ui:ContextualHelp.Title="Create System Restore Point"
                                ui:ContextualHelp.Summary="Creates a Windows System Restore checkpoint before you make system or app changes (requires Administrator elevation)."
                                ui:ContextualHelp.Impact="Reversible &amp; Safe — saves a recovery point in Windows System Protection." />
                    </StackPanel>

                    <DataGrid x:Name="DebloaterGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding DebloatItemsView}"
                              SelectedItem="{Binding SelectedDebloatItem}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HorizontalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              Background="{StaticResource BgCard}"
                              Foreground="{StaticResource TextPrimary}"
                              RowBackground="#1A202C"
                              AlternatingRowBackground="#151B26"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#2D3748"
                              HeadersVisibility="Column"
                              ui:ContextualHelp.Title="Debloater &amp; Cleanup Catalog"
                              ui:ContextualHelp.Summary="Check items to include in a batch optimization across UWP Bloatware, Win32 Programs, DISM Capabilities/Features, and Privacy/Performance Tweaks, or use the one-click Action button per row. Protected core Windows components stay locked."
                              ui:ContextualHelp.Impact="Reversible while browsing; applying/uninstalling launches an interactive Progress &amp; Status dialog.">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,1" Padding="10,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding ItemCount, StringFormat= ({0} items)}" Foreground="#94A3B8" FontSize="12" Margin="6,1,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="56" MinWidth="56" CanUserResize="False" />
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" IsReadOnly="True" Width="1.6*" MinWidth="170" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Kind}" IsReadOnly="True" Width="115" MinWidth="105" />
                            <DataGridTextColumn Header="Safety" Binding="{Binding SafetyLevel}" IsReadOnly="True" Width="105" MinWidth="95" />
                            <DataGridTextColumn Header="State / Ver" Binding="{Binding Version}" IsReadOnly="True" Width="100" MinWidth="90" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Publisher}" IsReadOnly="True" Width="1.1*" MinWidth="125" />
                            <DataGridTextColumn Header="Details" Binding="{Binding SafetyReason}" IsReadOnly="True" Width="2.1*" MinWidth="200" />
                            <DataGridTemplateColumn Header="Action" Width="96" MinWidth="96" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionButtonLabel}"
                                                Command="{Binding DataContext.ExecuteSingleDebloatCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                FontSize="11.5"
                                                Background="#1D4ED8"
                                                Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 6: AUDIT LOG -->
            <TabItem Header="Audit Log"
                     ui:ContextualHelp.Title="Audit Log Tab"
                     ui:ContextualHelp.Summary="Shows a timestamped history of every memory trim, automatic trigger, startup change, and temp cleanup performed by Memory Magic."
                     ui:ContextualHelp.Impact="Reversible — read-only activity log.">
                <DataGrid ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}"
                          RowBackground="#1A202C" AlternatingRowBackground="#151B26"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3748"
                          HeadersVisibility="Column" Margin="8"
                          ui:ContextualHelp.Title="Activity &amp; Audit History"
                          ui:ContextualHelp.Summary="Displays recent actions and warnings logged both in memory and in your local AppData log files."
                          ui:ContextualHelp.Impact="Reversible — read-only view.">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="80" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="65" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}" FontSize="12" />
        </Border>
    </Grid>
</Window>
